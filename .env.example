# ── Contacto → MongoDB Atlas (db `cdsmaia`) ─────────────────────────────
# Patrón portado de cdsmaia-cloud. El endpoint POST /api/contact guarda en
# la colección `portfolio_contactos`. Sin MONGODB_URI el sitio funciona igual
# pero el formulario responde 503.
#
# Atlas → Connect → Drivers. Copia la cadena completa, que ya incluye la base:
#   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cdsmaia?retryWrites=true&w=majority
MONGODB_URI=

# Base de datos dentro del clúster. Se crea sola al primer documento.
MONGODB_DB=cdsmaia

# Servidores DNS que usa Node para conectar al clúster (sólo desarrollo local
# cuando el log muestra `querySrv ECONNREFUSED`). En producción se deja vacío.
CONTACT_DNS=8.8.8.8,1.1.1.1

# Sal del hash de IP (cualquier cadena larga). Sin esto no se guarda hash.
CONTACT_SAL=

# Poner a `1` sólo detrás de un proxy/CDN que informe `x-forwarded-for`.
CONTACT_CONFIA_PROXY=

# Clave de Resend para el aviso por email de cada contacto nuevo (sólo
# servidor; nunca se lleva al navegador). Vacía = no se envía ningún email,
# el contacto se guarda en MongoDB igualmente.
RESEND_API_KEY=
# Destinatario del aviso. Por defecto: yovanysuarezsilva@gmail.com
CONTACT_AVISO_PARA=

# ── Ranking del arcade → MongoDB Atlas ────────────────────────────────────
# POST /api/arcade guarda cada partida en `arcade_puntajes` (db `cdsmaia`) y
# GET /api/arcade/ranking devuelve los mejores. El servidor comprueba que el
# marcador sea plausible antes de guardarlo (ronda de 25 a 70 s, y cada palabra
# vale entre 10 y 60 puntos).
#
# MONGODB_URI y MONGODB_DB se comparten con los otros dos endpoints.

# ── Orígenes permitidos (contacto, arcade y telemetría) ───────────────────
# Lista separada por comas. Vacío = sólo se acepta el tráfico del propio
# dominio (falla cerrado). En desarrollo el sitio (4200) y la API (4000) son
# puertos distintos, y el navegador manda `Origin` con el puerto del sitio: si
# no se declaran los dos, el POST del formulario se rechaza con 403.
# En producción: el dominio real, o vacío si el proxy conserva el Host original.
CONTACT_ORIGENES=
ARCADE_ORIGENES=
TELEMETRIA_ORIGENES=

# Poner a `1` sólo detrás de un proxy que informe la IP real (x-forwarded-for).
# El hash de IP usa la misma sal que la telemetría (TELEMETRIA_SAL/CONTACT_SAL).
ARCADE_CONFIA_PROXY=

# ── Telemetría de navegación → MongoDB Atlas ──────────────────────────────
# Port de cdsmaia-cloud. El endpoint POST /api/telemetria guarda en
# `telemetria_sesiones` y `telemetria_eventos` (db `cdsmaia`). Sin MONGODB_URI
# el endpoint responde 204 y no se guarda nada: el sitio funciona igual.
#
# MONGODB_URI y MONGODB_DB se comparten con el endpoint de contacto.

# Orígenes permitidos para el envío de lotes, separados por comas.
# Vacío = sólo se acepta el tráfico del propio dominio (falla cerrado).
TELEMETRIA_ORIGENES=

# Sal del hash de IP. Sin esto no se guarda ningún hash (campo null).
TELEMETRIA_SAL=

# Poner a `1` sólo detrás de un proxy que informe la IP real (x-forwarded-for).
TELEMETRIA_CONFIA_PROXY=

# Servidores DNS de respaldo para el driver de Node (sólo desarrollo local,
# cuando el log muestra `querySrv ECONNREFUSED`). Vacío = DNS del sistema.
# Compartido con CONTACT_DNS.
TELEMETRIA_DNS=8.8.8.8,1.1.1.1

# Interruptor de la telemetría en el navegador: se define en
# src/environments/environment*.ts (campo `telemetria`):
#   '1' fuerza, '0' apaga, '' mide sólo en producción.

